---
import Icon from "./Icon.astro";
import { GITHUB, CONTRIBUTING, SECURITY, LICENSE } from "../data/links";

const cards = [
  {
    icon: "layers",
    title: "AGPL-3.0 licensed",
    body: "Free to use, modify and self-host. Run a modified service and the licence keeps the source open for your users too.",
    href: LICENSE,
    link: "Read the licence",
  },
  {
    icon: "branch",
    title: "Built in the open",
    body: "Public roadmap, architecture decision records for every big call, and a contributor guide that gets you to a first PR fast.",
    href: CONTRIBUTING,
    link: "Contributing guide",
  },
  {
    icon: "shield",
    title: "Security-first",
    body: "A private disclosure policy, hardening decisions documented, and secure defaults — because it's a security platform.",
    href: SECURITY,
    link: "Security policy",
  },
] as const;
---

<section id="open-source" class="border-t border-border/60 py-20 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <p class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-fp-green-dark">
        Open source
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Open source. No asterisks.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        Your competition data lives in your Postgres. Challenges, teams —
        the whole platform state — export on demand. If Flagpost ever stops
        being right for you, you take everything with you.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      {cards.map((c, i) => (
        <a
          href={c.href}
          class="reveal group rounded-lg border border-border bg-card p-6 shadow-sm transition hover:border-fp-green-dark/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-md bg-fp-green-dark/10 text-fp-green-dark">
            <Icon name={c.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-4 font-display text-base font-semibold">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{c.body}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-fp-green-dark">
            {c.link}
            <Icon name="arrow-up-right" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </span>
        </a>
      ))}
    </div>

    <div class="reveal mt-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-border bg-card px-6 py-5">
      <p class="text-sm text-muted-foreground">
        Like where this is going? A star helps other organisers find it.
      </p>
      <a
        href={GITHUB}
        class="inline-flex h-10 items-center gap-2 whitespace-nowrap rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-safe:active:scale-[0.98]"
      >
        <Icon name="github" class="h-4 w-4" />
        tbcsec/flagpost
      </a>
    </div>
  </div>
</section>
