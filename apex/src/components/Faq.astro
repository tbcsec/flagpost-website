---
/**
 * Native <details> accordions — zero JS, keyboard-accessible for free, and
 * crawlers read the full text. Mirrored 1:1 by the FAQPage JSON-LD.
 */
import { faq } from "../data/faq";
---

<!-- Plain band: the muted band moved to the Roadmap section directly above,
     keeping the page's alternating rhythm intact. -->
<section id="faq" class="border-t border-border/60 py-20 sm:py-28">
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-fp-green-dark">
        FAQ
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Questions organisers ask
      </h2>
    </div>

    <div class="reveal mt-10 divide-y divide-border rounded-lg border border-border bg-card shadow-sm" style="--reveal-delay: 90ms">
      {faq.map((entry) => (
        <details class="group px-6 py-5 open:pb-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold marker:hidden focus-visible:outline-none [&::-webkit-details-marker]:hidden">
            {entry.question}
            <span class="text-xl leading-none text-muted-foreground transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted-foreground">
            {entry.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
