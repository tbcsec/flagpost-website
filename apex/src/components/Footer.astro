---
import Lockup from "./Lockup.astro";
import {
  GITHUB,
  DOCS,
  DEMO,
  DEPLOY_GUIDE,
  CONTRIBUTING,
  SECURITY,
  CODE_OF_CONDUCT,
  LICENSE,
} from "../data/links";

const columns = [
  {
    heading: "Product",
    links: [
      { label: "Features", href: "#features" },
      { label: "Automation", href: "#automation" },
      { label: "Comparison", href: "#compare" },
      { label: "Quick start", href: "#quick-start" },
      { label: "Roadmap", href: "#roadmap" },
      { label: "FAQ", href: "#faq" },
    ],
  },
  {
    heading: "Resources",
    links: [
      { label: "Documentation", href: DOCS },
      { label: "Live demo", href: DEMO },
      { label: "Deploy guide", href: DEPLOY_GUIDE },
      { label: "GitHub", href: GITHUB },
    ],
  },
  {
    heading: "Project",
    links: [
      { label: "Contributing", href: CONTRIBUTING },
      { label: "Security policy", href: SECURITY },
      { label: "Code of conduct", href: CODE_OF_CONDUCT },
      { label: "Licence (AGPL-3.0)", href: LICENSE },
    ],
  },
];
---

<footer class="border-t border-border/60 py-14">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <Lockup size={26} />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
          The modern, open-source platform for running capture-the-flag
          competitions — self-hosted, real-time, batteries included.
        </p>
      </div>

      {columns.map((col) => (
        <nav aria-label={col.heading}>
          <h3 class="font-display text-sm font-semibold">{col.heading}</h3>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-muted-foreground transition hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-border/60 pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center">
      <p>&copy; 2026 Tom Collier &middot; AGPL-3.0</p>
      <p>Built for the CTF community. Fly your flag. 🚩</p>
    </div>
  </div>
</footer>
