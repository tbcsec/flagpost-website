---
import Lockup from "./Lockup.astro";
import Icon from "./Icon.astro";
import { GITHUB, DOCS, DEMO } from "../data/links";

const anchors = [
  { href: "#features", label: "Features" },
  { href: "#automation", label: "Automation" },
  { href: "#compare", label: "Compare" },
  { href: "#quick-start", label: "Quick start" },
  { href: "#roadmap", label: "Roadmap" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-6 px-4 sm:px-6"
    aria-label="Main"
  >
    <a href="/" class="rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
      <Lockup size={28} />
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {anchors.map(({ href, label }) => (
        <a
          href={href}
          class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={DOCS}
        class="hidden rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:block"
      >
        Docs
      </a>
      <a
        href={DEMO}
        class="hidden rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:block"
      >
        Demo
      </a>
      <a
        href={GITHUB}
        class="inline-flex h-9 items-center gap-2 whitespace-nowrap rounded-md bg-secondary px-3.5 text-sm font-medium text-secondary-foreground transition hover:bg-secondary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring motion-safe:active:scale-[0.98]"
      >
        <Icon name="github" class="h-4 w-4" />
        GitHub
      </a>
    </div>
  </nav>
</header>
