---
/**
 * Deep dive: the When → If → Then automation engine, drawn as the rule
 * builder's three stages. Illustrative vignette in product tokens.
 */
import Icon from "./Icon.astro";

const triggers = [
  "Challenge solved",
  "First blood",
  "Ticket opened",
  "Team registered",
  "Score threshold",
  "T-60 minutes",
  "Competition ends",
];
---

<section id="automation" class="border-t border-border/60 bg-muted/20 py-20 sm:py-28">
  <div class="mx-auto grid w-full max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div class="reveal">
      <p class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-fp-green-dark">
        Automation
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Your event runs itself. You watch it happen.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        Every event on the platform — a solve, a ticket, the clock — can drive
        a rule you build visually. Notify people, release a hint, unlock a
        bonus wave, call a webhook, adjust a score, freeze the board, open the
        feedback survey. Schedule it all in advance and stop babysitting
        timers.
      </p>
      <ul class="mt-6 space-y-3 text-sm leading-relaxed">
        <li class="flex gap-3">
          <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-fp-green-dark" />
          <span><span class="font-medium">Time-based triggers</span> — “an hour before the end, open the survey and freeze the board.”</span>
        </li>
        <li class="flex gap-3">
          <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-fp-green-dark" />
          <span><span class="font-medium">SSRF-hardened webhooks</span> — wire Flagpost into Slack, Discord or anything with a URL, safely.</span>
        </li>
        <li class="flex gap-3">
          <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-fp-green-dark" />
          <span><span class="font-medium">Full audit trail</span> — every rule firing is logged with what it did and why.</span>
        </li>
      </ul>

      <div class="mt-7 flex flex-wrap gap-2" aria-label="Example automation triggers">
        {triggers.map((t) => (
          <span class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">
            {t}
          </span>
        ))}
      </div>
    </div>

    <div class="reveal" style="--reveal-delay: 120ms">
      <div class="relative space-y-3" role="img" aria-label="A visual automation rule: when first blood lands on a challenge, if the team is in the Open bracket, then announce it, grant an award and notify the judges.">
        <!-- connector spine -->
        <span class="absolute top-6 bottom-6 left-6 w-px bg-border" aria-hidden="true"></span>

        <div class="relative rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="relative z-10 flex h-5 items-center rounded-full bg-primary px-2.5 font-display text-[11px] font-bold uppercase tracking-wide text-primary-foreground">When</span>
            <span class="text-sm font-medium">First blood on any challenge</span>
          </div>
          <p class="mt-2 pl-[3.25rem] text-xs text-muted-foreground">event: challenge.solved &middot; first_solve = true</p>
        </div>

        <div class="relative rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="relative z-10 flex h-5 items-center rounded-full bg-warning px-2.5 font-display text-[11px] font-bold uppercase tracking-wide text-warning-foreground">If</span>
            <span class="text-sm font-medium">Bracket is “Open division”</span>
          </div>
          <p class="mt-2 pl-[3.25rem] text-xs text-muted-foreground">condition: team.bracket == open</p>
        </div>

        <div class="relative rounded-lg border border-fp-green-dark/40 bg-card p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="relative z-10 flex h-5 items-center rounded-full bg-success px-2.5 font-display text-[11px] font-bold uppercase tracking-wide text-success-foreground">Then</span>
            <span class="text-sm font-medium">Three actions, instantly</span>
          </div>
          <ul class="mt-3 space-y-2 pl-[3.25rem] text-xs text-muted-foreground">
            <li class="flex items-center gap-2">
              <Icon name="bell" class="h-3.5 w-3.5 text-fp-green-dark" />
              Post announcement: “🩸 First blood on Heap of Trouble!”
            </li>
            <li class="flex items-center gap-2">
              <Icon name="award" class="h-3.5 w-3.5 text-fp-green-dark" />
              Grant award: First Blood (+50)
            </li>
            <li class="flex items-center gap-2">
              <Icon name="users" class="h-3.5 w-3.5 text-fp-green-dark" />
              Notify the judge team
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
