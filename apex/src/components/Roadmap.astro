---
/**
 * Roadmap timeline — deliberately date-free (sequence over deadlines).
 * A centre spine with alternating cards on large screens, collapsing to a
 * single left spine on mobile. Nodes are plain icon dots: the mark is never
 * a bullet (LOGO-SPEC §7).
 */
import Icon from "./Icon.astro";
import { GITHUB } from "../data/links";

type Milestone = {
  icon: Parameters<typeof Icon>[0] extends never ? string : any;
  title: string;
  body: string;
  variant?: "today" | "done" | "cta";
  /** For "done" items: the release that shipped it, shown on the badge. */
  shippedIn?: string;
  href?: string;
  linkLabel?: string;
};

const milestones: Milestone[] = [
  {
    icon: "check",
    title: "Today",
    body: "Real-time competitions, the automation engine, AI assistants, collaborative notes, single sign-on, shareable certificates, post-event reports, four interface languages, CTFd-compatible import — everything on this page ships now, Apache-2.0.",
    variant: "today",
  },
  {
    icon: "check",
    title: "More authentication modules",
    body: "Delivered across two releases on one pluggable identity framework: OIDC/OAuth2 single sign-on in v1.2.0, then SAML 2.0 and LDAP/Active Directory in v1.3.0 — local login always surviving as break-glass.",
    variant: "done",
    shippedIn: "v1.3.0",
  },
  {
    icon: "check",
    title: "AI chatbot",
    body: "Shipped as an optional module, off by default: an administrator assistant for operational Q&A over a competition, and a guard-railed, audience-aware assistant for competitors — reviewable transcripts, bring-your-own provider.",
    variant: "done",
    shippedIn: "v1.4.0",
  },
  {
    icon: "check",
    title: "Custom certificate generation",
    body: "Shipped as an optional module: an in-app A4 designer over server-rendered PNGs, drawing name, placement, points and more from the final standings; released on a schedule or on demand, downloaded per participant or exported in bulk.",
    variant: "done",
    shippedIn: "v1.5.0",
  },
  {
    icon: "check",
    title: "On-demand challenge instances",
    body: "An isolated, containerised copy of a challenge for each team or player, spun up on demand and reaped on a TTL — reached over TCP or a per-instance HTTPS subdomain, with unique per-instance flags and a Docker or Kubernetes provisioner behind one least-privilege contract. Live infrastructure for pwn-, web- and cloud-heavy events.",
    variant: "done",
    shippedIn: "v1.6.0",
  },
  {
    icon: "package",
    title: "Module SDK, importing & marketplace",
    body: "A documented SDK for building modules, clean packaging and import, and a marketplace with verified publishers.",
  },
  {
    icon: "code",
    title: "Programming challenges",
    body: "Programming and secure-coding formats as first-class competition types beside CTFs.",
  },
  {
    icon: "crosshair",
    title: "Cheat detection engine",
    body: "Flag-sharing and anomaly signals surfaced to judges — evidence for humans, not silent auto-bans.",
  },
  {
    icon: "github",
    title: "Have a say",
    body: "The roadmap is shaped in the open. Propose a feature, or weigh in on what should come first.",
    variant: "cta",
    href: GITHUB,
    linkLabel: "Join the discussion",
  },
];
---

<section id="roadmap" class="border-t border-border/60 py-20 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <p class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-fp-green-dark">
        Roadmap
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        The next flags to plant.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        These are the big swings coming to the platform, built in the open
        like everything else — and ticked off here as they ship.
      </p>
    </div>

    <div class="relative mt-14">
      <!-- Spine: green at "today", fading into the future. -->
      <span
        class="absolute bottom-4 left-[1.125rem] top-4 w-px -translate-x-1/2 bg-gradient-to-b from-fp-green-dark/70 via-border to-border md:left-1/2"
        aria-hidden="true"></span>

      <ol class="space-y-8 md:space-y-10">
        {milestones.map((m, i) => (
          <li
            class="reveal relative md:grid md:grid-cols-[1fr_4.5rem_1fr] md:items-start"
            style={`--reveal-delay: ${Math.min(i, 3) * 60}ms`}
          >
            <span
              class:list={[
                "absolute left-0 top-0 flex h-9 w-9 items-center justify-center rounded-full border md:static md:col-start-2 md:row-start-1 md:justify-self-center",
                m.variant === "today" || m.variant === "done"
                  ? "border-fp-green-dark bg-fp-green-dark text-primary-foreground"
                  : m.variant === "cta"
                    ? "border-dashed border-fp-green-dark/60 bg-card text-fp-green-dark"
                    : "border-border bg-card text-fp-green-dark",
              ]}
            >
              <Icon name={m.icon} class="h-4 w-4" />
            </span>

            <div
              class:list={[
                "ml-14 rounded-lg border p-5 shadow-sm md:ml-0 md:row-start-1",
                i % 2 === 0 ? "md:col-start-1" : "md:col-start-3",
                m.variant === "today"
                  ? "border-fp-green-dark/40 bg-card"
                  : m.variant === "done"
                    ? "border-fp-green-dark/30 bg-card"
                    : m.variant === "cta"
                      ? "border-dashed border-border bg-transparent"
                      : "border-border bg-card",
              ]}
            >
              <h3 class="font-display text-base font-semibold">
                {m.variant === "today" || m.variant === "done" ? (
                  <span class="inline-flex flex-wrap items-center gap-2.5">
                    {m.title}
                    <span class="whitespace-nowrap rounded-full bg-fp-green-dark/10 px-2.5 py-0.5 text-[11px] font-semibold tracking-wide text-fp-green-dark">
                      {m.variant === "done" ? `SHIPPED · ${m.shippedIn}` : "SHIPPED"}
                    </span>
                  </span>
                ) : (
                  m.title
                )}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{m.body}</p>
              {m.href && (
                <a
                  href={m.href}
                  class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-fp-green-dark hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >
                  {m.linkLabel}
                  <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
