---
import Base from "../layouts/Base.astro";
import FlagpostMark from "../components/FlagpostMark.astro";
import Icon from "../components/Icon.astro";
import { WEBSITE_REPO } from "../data/links";
---

<Base
  title="Page not found — Flagpost"
  description="There's nothing planted at this URL."
>
  <main id="main" class="relative flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <div class="hero-bg" aria-hidden="true"></div>

    <FlagpostMark size={72} />
    <p class="mt-8 font-display text-xs font-semibold uppercase tracking-[0.16em] text-fp-green-dark">
      404
    </p>
    <h1 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      Flag not found.
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-muted-foreground">
      There's nothing planted at this URL. If a link on our site led you here,
      that's a bug worth reporting.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-11 items-center justify-center whitespace-nowrap rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-safe:active:scale-[0.98]"
      >
        Back to flagpost.io
      </a>
      <a
        href={`${WEBSITE_REPO}/issues`}
        class="inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input px-6 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring motion-safe:active:scale-[0.98]"
      >
        <Icon name="github" class="h-4 w-4" />
        Report it
      </a>
    </div>
  </main>
</Base>
